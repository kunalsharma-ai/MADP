# Copy to .env for local development. Never commit .env. Production values come from the secrets manager.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://madp:madp@localhost:5432/madp
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=madp
# Generate: openssl rand -hex 32
AUTH_JWT_SECRET=
# Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# Key rotation (optional): extra keys as k2=<base64>,k3=<base64>; new values use FIELD_ENCRYPTION_ACTIVE_KEY.
# After switching, run: pnpm --filter @madp/api keys:rotate
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KEY=k1
# Generate: openssl rand -hex 32
PII_HASH_KEY=
REQUIRE_MFA=true
ADMIN_ORIGIN=http://localhost:3000
MIN_CELL_SIZE=5
DEMO_POPULATION_SIZE=1500
# Live, read-only access to a panel's production data is OFF until explicitly approved.
# Comma-separated subset of t2o,mfr,mho. Leave empty to run every connector on DEMO fixtures.
LIVE_SOURCE_APPROVED_PANELS=
T2O_API_BASE_URL=
T2O_API_TOKEN=
MFR_API_BASE_URL=
MFR_API_TOKEN=
MHO_API_BASE_URL=
MHO_API_TOKEN=
# Automatic sync of live panels from their changed-since feeds. 0 = off. Try 5 once a panel serves the feed.
SYNC_INTERVAL_MINUTES=0
SYNC_MAX_PAGES=100
# Signed webhooks from each panel (POST /api/v1/webhooks/<panel>). Empty = off for that panel.
# One or more comma-separated secrets, each at least 32 characters (openssl rand -hex 32). Two at once = rotation.
WEBHOOK_SECRETS_T2O=
WEBHOOK_SECRETS_MFR=
WEBHOOK_SECRETS_MHO=
WEBHOOK_TOLERANCE_SECONDS=300
# Admin app
MADP_API_URL=http://localhost:4000/api/v1
