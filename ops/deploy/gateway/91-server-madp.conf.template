# MADP's gateway. Plain HTTP on the publicweb network: TLS and http->https happen in the shared front proxy, which
# routes ${MADP_HOST} here. Nothing else reaches MADP's services.
server {
    listen 80;
    server_name ${MADP_HOST};

    server_tokens off;
    client_max_body_size 25m;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 120s;

    access_log /dev/stdout proxy;
    error_log /dev/stderr warn;

    include /etc/nginx/conf.d/21-headers.inc;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://$upstream;
    }
}

# Any other host name on this gateway gets nothing.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
