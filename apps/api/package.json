{
  "name": "@madp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env dist/scripts/migrate.js",
    "db:seed:demo": "node --env-file-if-exists=../../.env dist/scripts/seed-demo.js",
    "admin:create": "node --env-file-if-exists=../../.env dist/scripts/create-admin.js",
    "keys:rotate": "node --env-file-if-exists=../../.env dist/scripts/rotate-field-keys.js"
  },
  "dependencies": {
    "@madp/config": "workspace:*",
    "@madp/connectors": "workspace:*",
    "@madp/contracts": "workspace:*",
    "@madp/panel-contract": "workspace:*",
    "@madp/testing": "workspace:*",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/throttler": "6.8.0",
    "argon2": "0.45.2",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "jose": "6.2.18",
    "jszip": "3.10.2",
    "mongodb": "7.9.1",
    "otpauth": "9.6.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.0",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.2",
    "typescript": "7.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.1"
  }
}
